{
  "name": "Hacienda Ganadera — desarrollo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "prisma.prisma",
        "ms-azuretools.vscode-docker",
        "bierner.markdown-mermaid",
        "redhat.vscode-yaml",
        "humao.rest-client",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "editor.rulers": [100],
        "files.eol": "\n",
        "typescript.tsdk": "node_modules/typescript/lib",
        "markdown.preview.breaks": true
      }
    }
  },
  "forwardPorts": [3000, 3001, 5432, 6379, 9000, 9001],
  "portsAttributes": {
    "3000": { "label": "web", "onAutoForward": "openPreview" },
    "3001": { "label": "api" },
    "5432": { "label": "postgres", "onAutoForward": "silent" },
    "6379": { "label": "redis", "onAutoForward": "silent" },
    "9000": { "label": "minio", "onAutoForward": "silent" },
    "9001": { "label": "minio consola", "onAutoForward": "silent" }
  },
  "postCreateCommand": "node scripts/ci/check-docs.mjs && echo 'Entorno listo. Ver README.md'",
  "remoteUser": "node",
  "mounts": [
    "source=hacienda-pnpm-store,target=/home/node/.local/share/pnpm/store,type=volume"
  ]
}
