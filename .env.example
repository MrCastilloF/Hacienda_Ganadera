# ──────────────────────────────────────────────────────────────────────────────
#  Hacienda Ganadera — plantilla de variables de entorno
#  Copiar a .env y completar.  NUNCA commitear el .env real.
#  Generar secretos con:  openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────

# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Hacienda Ganadera"
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info
TZ=America/Bogota

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hacienda
POSTGRES_USER=hacienda_app
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
POSTGRES_SUPERUSER=hacienda_owner
POSTGRES_SUPERUSER_PASSWORD=CAMBIAR_ESTA_CLAVE
DATABASE_URL=postgresql://hacienda_app:CAMBIAR_ESTA_CLAVE@postgres:5432/hacienda?schema=public
DATABASE_URL_MIGRATOR=postgresql://hacienda_owner:CAMBIAR_ESTA_CLAVE@postgres:5432/hacienda

# ── Redis / colas ─────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── Autenticación ─────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=8h
JWT_ISSUER=hacienda-ganadera
JWT_AUDIENCE=hacienda-web
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
MFA_ISSUER="Hacienda Ganadera"
MFA_ENFORCE_ROLES=superadmin,administrador
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OFFLINE_PERMISSION_SNAPSHOT_TTL=12h

# ── Archivos / documentos ─────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=hacienda-documents
S3_BUCKET_EXPORTS=hacienda-exports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CAMBIAR_ESTA_CLAVE
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300
MAX_UPLOAD_MB=25
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Local Bridge ──────────────────────────────────────────────────────────────
BRIDGE_ENROLLMENT_SECRET=CAMBIAR_ESTA_CLAVE
BRIDGE_MTLS_CA_PATH=/run/secrets/ca.pem
BRIDGE_HEARTBEAT_SECONDS=30
BRIDGE_QUEUE_MAX_AGE_HOURS=72
SCALE_DEFAULT_PROTOCOL=generic-ascii
SCALE_DEFAULT_BAUD=9600
SCALE_DEFAULT_PARITY=none
SCALE_DEFAULT_DATABITS=8
SCALE_DEFAULT_STOPBITS=1
SCALE_STABILITY_TOLERANCE_KG=0.5
SCALE_STABILITY_WINDOW_MS=1200
SCALE_STABILITY_MIN_SAMPLES=5
SCALE_STABILITY_TIMEOUT_MS=10000

# ── LoRaWAN / IoT (opcional) ──────────────────────────────────────────────────
LORA_ENABLED=false
LORA_MQTT_URL=mqtt://mosquitto:1883
LORA_MQTT_USERNAME=
LORA_MQTT_PASSWORD=
LORA_MQTT_TOPIC=application/+/device/+/event/up
LORA_WEBHOOK_SECRET=CAMBIAR_ESTA_CLAVE
LORA_DEDUPE_WINDOW_SECONDS=60
LORA_MAX_UPLINKS_PER_SECOND=200
CHIRPSTACK_API_URL=http://chirpstack:8080
CHIRPSTACK_API_TOKEN=

# ── Correo ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hacienda Ganadera <no-reply@ejemplo.com>"

# ── Mapas ─────────────────────────────────────────────────────────────────────
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="© OpenStreetMap contributors"
MAP_PROVIDER=leaflet

# ── Observabilidad ────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9464
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE

# ── Respaldo ──────────────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/backups
BACKUP_ENCRYPTION_KEY=CAMBIAR_ESTA_CLAVE

# ── Proxy / TLS ───────────────────────────────────────────────────────────────
DOMAIN=localhost
ACME_EMAIL=admin@ejemplo.com
TLS_MODE=internal

# ── Feature flags (fase 0: todo apagado) ──────────────────────────────────────
FF_OFFLINE_MODE=false
FF_IOT=true
FF_MAPS=true
FF_REPORTS=true
FF_MFA=false
