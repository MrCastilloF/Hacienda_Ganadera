// Esquema de Prisma para el dominio de la Fase 1.
//
// IMPORTANTE (ADR-0002): este archivo NO es la fuente de verdad del esquema.
// La fuente de verdad son las migraciones SQL de infra/postgres/migrations.
// Prisma se usa como cliente tipado; `prisma migrate` y `prisma db push` están
// prohibidos sobre entornos con datos.
//
// Las tablas de trazabilidad (audit_log, evento_dominio, outbox,
// idempotency_record) se manipulan con SQL tipado porque usan particiones,
// funciones y triggers que Prisma no modela.

generator client {
  provider = "prisma-client-js"
  // `native` cubre el equipo de desarrollo; el target explícito cubre la imagen
  // Debian bookworm del contenedor, donde Prisma no puede detectar OpenSSL si el
  // binario no está instalado en la etapa de build (provocaba un fallo real).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "public"]
}

model Finca {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String?   @map("tenant_id") @db.Uuid
  codigo                  String    @unique
  nombre                  String
  propietario             String?
  identificacionTributaria String?  @map("identificacion_tributaria")
  direccion               String?
  zonaHoraria             String    @default("America/Bogota") @map("zona_horaria")
  moneda                  String    @default("COP") @db.Char(3)
  unidadPeso              String    @default("kg") @map("unidad_peso")
  activa                  Boolean   @default(true)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy               String?   @map("created_by") @db.Uuid
  updatedBy               String?   @map("updated_by") @db.Uuid
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  usuarios UsuarioFinca[]
  lotes    Lote[]
  animales Animal[]
  basculas Bascula[]
  bridges  Bridge[]
  pesajes  Pesaje[]
  tratamientos Tratamiento[]

  @@map("finca")
  @@schema("app")
}

model Usuario {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String?   @map("tenant_id") @db.Uuid
  email              String
  passwordHash       String    @map("password_hash")
  nombre             String
  cargo              String?
  activo             Boolean   @default(true)
  mfaHabilitado      Boolean   @default(false) @map("mfa_habilitado")
  mfaSecretEnc       String?   @map("mfa_secret_enc")
  intentosFallidos   Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta     DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  ultimoAccesoAt     DateTime? @map("ultimo_acceso_at") @db.Timestamptz(6)
  passwordCambiadaAt DateTime  @default(now()) @map("password_cambiada_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles    UsuarioRol[]
  fincas   UsuarioFinca[]
  sesiones Sesion[]

  @@index([activo], map: "ix_usuario_activo")
  @@map("usuario")
  @@schema("app")
}

model Rol {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String   @unique
  nombre      String
  descripcion String?
  sistema     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  permisos RolePermiso[]
  usuarios UsuarioRol[]

  @@map("rol")
  @@schema("app")
}

model Permiso {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String   @unique
  modulo      String
  operacion   String
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermiso[]

  @@index([modulo], map: "ix_permiso_modulo")
  @@map("permiso")
  @@schema("app")
}

model RolePermiso {
  rolId     String @map("rol_id") @db.Uuid
  permisoId String @map("permiso_id") @db.Uuid
  alcance   String @default("finca")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId, alcance])
  @@map("rol_permiso")
  @@schema("app")
}

model UsuarioRol {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  rolId     String   @map("rol_id") @db.Uuid
  fincaId   String?  @map("finca_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Restrict)

  @@map("usuario_rol")
  @@schema("app")
}

model UsuarioFinca {
  usuarioId       String  @map("usuario_id") @db.Uuid
  fincaId         String  @map("finca_id") @db.Uuid
  esPredeterminada Boolean @default(false) @map("es_predeterminada")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  finca   Finca   @relation(fields: [fincaId], references: [id], onDelete: Restrict)

  @@id([usuarioId, fincaId])
  @@map("usuario_finca")
  @@schema("app")
}

model Sesion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId         String    @map("usuario_id") @db.Uuid
  refreshFamily     String    @map("refresh_family") @db.Uuid
  refreshHash       String    @unique @map("refresh_hash")
  userAgent         String?   @map("user_agent")
  ip                String?
  creadaAt          DateTime  @default(now()) @map("creada_at") @db.Timestamptz(6)
  expiraAt          DateTime  @map("expira_at") @db.Timestamptz(6)
  revocadaAt        DateTime? @map("revocada_at") @db.Timestamptz(6)
  reemplazadaPor    String?   @map("reemplazada_por") @db.Uuid
  motivoRevocacion  String?   @map("motivo_revocacion")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, creadaAt(sort: Desc)], map: "ix_sesion_usuario")
  @@index([refreshFamily], map: "ix_sesion_family")
  @@map("sesion")
  @@schema("app")
}

model IntentoLogin {
  id        BigInt   @id @default(autoincrement())
  email     String
  ip        String?
  exito     Boolean
  motivo    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)


  @@map("intento_login")
  @@schema("app")
}

model Configuracion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fincaId       String?   @map("finca_id") @db.Uuid
  clave         String
  valorJson     Json      @map("valor_json")
  version       Int       @default(1)
  vigenteDesde  DateTime  @default(now()) @map("vigente_desde") @db.Timestamptz(6)
  vigenteHasta  DateTime? @map("vigente_hasta") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid

  @@map("configuracion")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Fase 2 · Animales
// ─────────────────────────────────────────────────────────────────────────────

model Raza {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String   @unique
  nombre    String
  especie   String   @default("BOVINO")
  origen    String?
  activo    Boolean  @default(true)
  source    String   @default("SEED")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  animales Animal[]

  @@map("raza")
  @@schema("app")
}

model CategoriaAnimal {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo       String   @unique
  nombre       String
  sexo         String
  edadMinMeses Int?     @map("edad_min_meses")
  edadMaxMeses Int?     @map("edad_max_meses")
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("categoria_animal")
  @@schema("app")
}

model Lote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fincaId   String   @map("finca_id") @db.Uuid
  codigo    String
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  finca    Finca    @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  animales Animal[]

  @@unique([fincaId, codigo])
  @@map("lote")
  @@schema("app")
}

model Animal {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fincaId                String    @map("finca_id") @db.Uuid
  arete                  String
  codigoBarras           String    @map("codigo_barras")
  rfid                   String?
  nombre                 String?
  sexo                   String
  fechaNacimiento        DateTime? @map("fecha_nacimiento") @db.Date
  pesoNacimientoKg       Decimal?  @map("peso_nacimiento_kg") @db.Decimal(8, 2)
  razaId                 String?   @map("raza_id") @db.Uuid
  cruceRacial            String?   @map("cruce_racial")
  color                  String?
  caracteristicas        String?
  procedencia            String?
  madreId                String?   @map("madre_id") @db.Uuid
  padreId                String?   @map("padre_id") @db.Uuid
  tipoNacimiento         String?   @map("tipo_nacimiento")
  estado                 String    @default("activo")
  estadoProductivo       String?   @map("estado_productivo")
  condicionCorporal      Int?      @map("condicion_corporal") @db.SmallInt
  loteId                 String?   @map("lote_id") @db.Uuid
  corral                 String?
  identificacionOficial  String?   @map("identificacion_oficial")
  observaciones          String?
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  finca           Finca                   @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  raza            Raza?                   @relation(fields: [razaId], references: [id], onDelete: Restrict)
  lote            Lote?                   @relation(fields: [loteId], references: [id], onDelete: Restrict)
  madre           Animal?                 @relation("Madre", fields: [madreId], references: [id], onDelete: Restrict)
  padre           Animal?                 @relation("Padre", fields: [padreId], references: [id], onDelete: Restrict)
  criasComoMadre  Animal[]                @relation("Madre")
  criasComoPadre  Animal[]                @relation("Padre")
  identificaciones AnimalIdentificacion[]
  estados         AnimalEstadoHistorial[]
  pesajes         Pesaje[]
  tratamientos    Tratamiento[]

  @@unique([fincaId, arete], map: "uq_animal_finca_arete")
  @@unique([codigoBarras], map: "uq_animal_codigo_barras")
  @@index([fincaId, estado], map: "ix_animal_finca_estado")
  @@map("animal")
  @@schema("app")
}

model AnimalIdentificacion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId      String    @map("animal_id") @db.Uuid
  tipo          String
  valor         String
  vigenteDesde  DateTime  @default(now()) @map("vigente_desde") @db.Timestamptz(6)
  vigenteHasta  DateTime? @map("vigente_hasta") @db.Timestamptz(6)
  estado        String    @default("active")
  motivo        String?
  createdBy     String?   @map("created_by") @db.Uuid

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@index([animalId], map: "ix_ident_animal")
  @@map("animal_identificacion")
  @@schema("app")
}

model AnimalEstadoHistorial {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId       String   @map("animal_id") @db.Uuid
  estadoAnterior String?  @map("estado_anterior")
  estadoNuevo    String   @map("estado_nuevo")
  motivo         String?
  actorId        String?  @map("actor_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@index([animalId], map: "ix_estado_animal")
  @@map("animal_estado_historial")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Fase 3 · Básculas, bridges y pesajes
// ─────────────────────────────────────────────────────────────────────────────

model Bascula {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fincaId            String   @map("finca_id") @db.Uuid
  nombre             String
  marca              String?
  modelo             String?
  serie              String?
  protocolId         String   @default("generic-ascii") @map("protocol_id")
  transporte         String   @default("SERIAL")
  configJson         Json     @default("{}") @map("config_json")
  toleranceKg        Decimal  @default(0.5) @map("tolerance_kg") @db.Decimal(6, 2)
  windowMs           Int      @default(1200) @map("window_ms")
  minSamples         Int      @default(5) @map("min_samples")
  minKg              Decimal  @default(0) @map("min_kg") @db.Decimal(8, 2)
  maxKg              Decimal  @default(2000) @map("max_kg") @db.Decimal(8, 2)
  estadoIntegracion  String   @default("declared") @map("estado_integracion")
  activa             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid

  finca    Finca    @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  pesajes  Pesaje[]

  @@unique([fincaId, nombre], map: "uq_bascula_nombre")
  @@map("bascula")
  @@schema("app")
}

model Bridge {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fincaId            String    @map("finca_id") @db.Uuid
  nombre             String
  version            String?
  huellaCertificado  String?   @map("huella_certificado")
  estado             String    @default("pendiente")
  ultimaComunicacion DateTime? @map("ultima_comunicacion") @db.Timestamptz(6)
  colaPendiente      Int       @default(0) @map("cola_pendiente")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  finca   Finca    @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  pesajes Pesaje[]

  @@unique([fincaId, nombre], map: "uq_bridge_nombre")
  @@map("bridge")
  @@schema("app")
}

model Pesaje {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fincaId        String    @map("finca_id") @db.Uuid
  animalId       String    @map("animal_id") @db.Uuid
  basculaId      String?   @map("bascula_id") @db.Uuid
  bridgeId       String?   @map("bridge_id") @db.Uuid
  pesoKg         Decimal   @map("peso_kg") @db.Decimal(8, 2)
  tipo           String    @default("CONTROL")
  ocurridoAt     DateTime  @map("ocurrido_at") @db.Timestamptz(6)
  recibidoAt     DateTime  @default(now()) @map("recibido_at") @db.Timestamptz(6)
  registradoPor  String?   @map("registrado_por") @db.Uuid
  edadDias       Int?      @map("edad_dias")
  observaciones  String?
  origen         String
  duplicateOf    String?   @map("duplicate_of") @db.Uuid
  tramaCruda     String?   @map("trama_cruda")
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  finca      Finca    @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Restrict)
  bascula    Bascula? @relation(fields: [basculaId], references: [id], onDelete: Restrict)
  bridge     Bridge?  @relation(fields: [bridgeId], references: [id], onDelete: Restrict)

  anulacion  PesajeAnulacion?

  @@index([animalId], map: "ix_pesaje_animal_fecha")
  @@index([fincaId], map: "ix_pesaje_finca_fecha")
  @@map("pesaje")
  @@schema("app")
}


model PesajeAnulacion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pesajeId   String   @unique @map("pesaje_id") @db.Uuid
  motivo     String
  actorId    String?  @map("actor_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  pesaje Pesaje @relation(fields: [pesajeId], references: [id], onDelete: Restrict)

  @@map("pesaje_anulacion")
  @@schema("app")
}


model Tratamiento {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fincaId          String    @map("finca_id") @db.Uuid
  animalId         String    @map("animal_id") @db.Uuid
  medicamento      String
  principioActivo  String?   @map("principio_activo")
  dosis            String?
  via              String?
  diagnostico      String?
  motivo           String?
  iniciadoAt       DateTime  @map("iniciado_at") @db.Timestamptz(6)
  diasTratamiento  Int       @default(1) @map("dias_tratamiento")
  diasRetiro       Int       @default(0) @map("dias_retiro")
  finTratamiento   DateTime  @map("fin_tratamiento") @db.Timestamptz(6)
  finRetiro        DateTime  @map("fin_retiro") @db.Timestamptz(6)
  veterinario      String?
  observaciones    String?
  origen           String    @default("FIELD")
  registradoPor    String?   @map("registrado_por") @db.Uuid
  idempotencyKey   String    @unique @map("idempotency_key") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  finca     Finca                @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  animal    Animal               @relation(fields: [animalId], references: [id], onDelete: Restrict)
  anulacion TratamientoAnulacion?

  @@index([animalId], map: "ix_tratamiento_animal")
  @@map("tratamiento")
  @@schema("app")
}

model TratamientoAnulacion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tratamientoId String   @unique @map("tratamiento_id") @db.Uuid
  motivo        String
  actorId       String?  @map("actor_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tratamiento Tratamiento @relation(fields: [tratamientoId], references: [id], onDelete: Restrict)

  @@map("tratamiento_anulacion")
  @@schema("app")
}
